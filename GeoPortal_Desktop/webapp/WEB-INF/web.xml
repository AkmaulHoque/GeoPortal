<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>AgriGeo Research GeoPortal</display-name>
    <welcome-file-list><welcome-file>index.html</welcome-file></welcome-file-list>

    <!--
      One API gateway owns /api/* so health/config/preview/process/export can
      never drift into different servlet mappings between WAR revisions.
      Multipart limits here cover both dataset upload and drawing SHP export.
    -->
    <servlet>
      <servlet-name>apiGateway</servlet-name>
      <servlet-class>org.geoportal.ApiGatewayServlet</servlet-class>
      <multipart-config>
        <max-file-size>2147483648</max-file-size>
        <max-request-size>2148532224</max-request-size>
        <file-size-threshold>1048576</file-size-threshold>
      </multipart-config>
    </servlet>
    <servlet-mapping>
      <servlet-name>apiGateway</servlet-name>
      <url-pattern>/api/*</url-pattern>
    </servlet-mapping>

    <session-config>
      <cookie-config><http-only>true</http-only><secure>false</secure></cookie-config>
    </session-config>
</web-app>
